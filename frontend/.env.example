# Copy to frontend/.env.local and fill in.
# These three are compiled into the browser bundle, so they are public by design:
# a Cognito SPA client has no secret (GenerateSecret: false). Point them at your
# own pool anyway. Running against someone else's creates real accounts in it.

NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_COGNITO_DOMAIN=""
NEXT_PUBLIC_APP_CLIENT_ID=""
