# Copy to backend/.env and fill in. Every value names a resource in YOUR AWS
# account, not ours: point this at your own stack, never at someone else's.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1

# From your own `sam deploy` (see README for the two commands that read them back).
# USER_TABLE is required: storage.py builds the DynamoDB handle at import, so the
# API will not start without it.
USER_TABLE=
USER_POOL=
APP_CLIENT=

# Inbox that contact-page messages are delivered to. Must be SES-verified.
CONTACT_EMAIL=
